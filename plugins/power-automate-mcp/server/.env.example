# Power Automate MCP server configuration (all optional).
# Copy to .env only if you need to override defaults. The default path
# (PA_MCP_AUTH=azcli) needs nothing here — just `az login`.

# Auth mode: azcli (default) | devicecode
PA_MCP_AUTH=azcli

# Override the Azure CLI binary if it is not "az"/"az.cmd" on PATH.
# PA_MCP_AZ_BIN=az.cmd

# Device-code fallback (PA_MCP_AUTH=devicecode). Leave CLIENT_ID unset to use
# the public Azure CLI client. Set both to use your own Entra app registration
# for tenants that block the CLI client for the Flow resource.
# PA_MCP_CLIENT_ID=
# PA_MCP_TENANT_ID=

# Log verbosity: error (default) | info | debug  — written to stderr only.
# PA_MCP_LOG=info
